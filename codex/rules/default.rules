prefix_rule(pattern=["python3", "-c", "from pathlib import Path; from evals.framework.eval_storage import eval_data_manifest_id, hydrate_eval_data, load_eval_data_manifest; m=load_eval_data_manifest(Path('evals/internal/bsbench/case_sets/44_resveratrol_sirt1_fluorophore/pre_blind/data-manifest.json')); expected='5695a52050d5e57e9ac968ad839c62e071eaa6646a186c5073483e3e2ed5c594'; assert eval_data_manifest_id(m)==expected; d=Path('/data/evals/data/bsbench/44_resveratrol_sirt1_fluorophore/pre_blind')/expected; paths=hydrate_eval_data(m,d); assert len(paths)==1; print('manifest and hydration: PASS')"], decision="allow")
