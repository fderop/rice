# Managed by rice — re-running setup.sh overwrites this file.
# Persistent low-risk command prefixes that may run without prompting when
# Codex needs to execute them outside the sandbox.

prefix_rule(pattern = ["rg"], decision = "allow")
prefix_rule(pattern = ["sed"], decision = "allow")
prefix_rule(pattern = ["find"], decision = "allow")
prefix_rule(pattern = ["ls"], decision = "allow")
