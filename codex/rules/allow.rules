prefix_rule(pattern = ["git", "diff"], decision = "allow")
prefix_rule(pattern = ["git", "diff", "--cached"], decision = "allow")
prefix_rule(pattern = ["git", "commit", "-m"], decision = "allow")
prefix_rule(pattern = ["git", "push", "-u", "origin"], decision = "allow")
prefix_rule(pattern = ["./node_modules/.bin/next", "dev"], decision = "allow")
prefix_rule(pattern = ["node", "/home/fdr/.codex/skills/.system/openai-docs/scripts/fetch-codex-manual.mjs"], decision = "allow")
